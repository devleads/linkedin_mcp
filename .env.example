# Database
DATABASE_URL=postgresql://linkedin:linkedin@localhost:5432/linkedin

# Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINKEDIN_CREDENTIAL_ENCRYPTION_KEY=

# Proxy Configuration
# Active proxy provider backend: oxylabs, ipfoxy, or apify
# Example values:
#   PROXY_PROVIDER=oxylabs
#   PROXY_PROVIDER=ipfoxy
#   PROXY_PROVIDER=apify
PROXY_PROVIDER=ipfoxy

# Oxylabs credentials (required when PROXY_PROVIDER=oxylabs)
OXYLABS_USERNAME=your_username
OXYLABS_PASSWORD=your_password

# Proxy mode: mobile (sticky ports) or residentials (country/city targeting)
OXYLABS_PROXY_TYPE=mobile

# Residential fallback host (port is code-defined)
OXYLABS_RESIDENTIAL_HOST=pr.oxylabs.io

# IPFoxy is configured per profile in DB (host/port/username/password fields)

# Apify residential proxy (required when PROXY_PROVIDER=apify)
# Get password from https://console.apify.com/settings/proxy
# Each profile uses a fixed country (and US state if applicable) for
# session-based sticky sessions (~30 min per session ID).
APIFY_PROXY_PASSWORD=
APIFY_PROXY_GROUPS=RESIDENTIAL

# Browser settings
HEADLESS=false

# Xvfb: run Chrome headful inside a virtual display (Docker only).
# Required for LinkedIn bot detection avoidance — headless Chrome is easily detected.
# When enabled, the entrypoint starts Xvfb on :99 and sets DISPLAY=:99.
USE_XVFB=1

# MCP Server (HTTP API for scripts)
MCP_HOST=0.0.0.0
MCP_PORT=8765

# Browser debug delay (seconds to keep browser open after request, 0 for production)
BROWSER_DEBUG_DELAY=0

# Browser isolation - each request opens its own browser window (recommended: false)
BROWSER_ISOLATE_SESSIONS=true

# Profile cooldown after auth/challenge detection (minutes)
CHALLENGE_COOLDOWN_MINUTES=15

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=text  # text (development) or json (production)
